import time
from servo import Servo, servo2040

# Setup servo
s = Servo(servo2040.SERVO_1)
s.enable()

# Tuned pulse limits for 0 to 270 degrees
MIN_PULSE = 550
MAX_PULSE = 2560

def set_angle(angle):
    pulse_us = int(MIN_PULSE + (angle / 270) * (MAX_PULSE - MIN_PULSE))
    s.pulse(pulse_us)

angles = [0, 90, 180, 270, 180, 90, 0]

while True:
    time.sleep(5)
    for angle in angles:
        set_angle(angle)
        print(f"Servo Angle:", angle)
        time.sleep(1)

