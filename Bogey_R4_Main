            Serial1.println("S, 135,135,135,135,135, 135,   135,135,135,135,135,  90,135,135,135,135,135,  135,135,  135,135,135,135,135,135");
            delay(300);
            Serial1.println("S, 135,135,135,135,135, 135,   135,135,135,135,135,  180,135,135,135,135,135,  135,135,  135,135,135,135,135,135");
            delay(300);
          }
          for (int i = 0; i < 4; i = i + 1) {
            Serial1.println("S, 135,135,135,135,135, 135,   135,135,135,135,135,  135,135,90,135,135,135,  135,135,  135,135,135,135,135,135");
