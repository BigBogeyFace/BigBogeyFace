String Command_List[] = { "TEST", "CRUSH" };

// Check BLE:
void Check_BLE() {
  BLEDevice central = BLE.central();

  if (central) {
    while (central.connected()) {
      matrix.renderBitmap(Bluetooth_Connected, 12, 8);

      // Check BLE for Data:
      if (rxChar.written()) {
        int len = rxChar.valueLength();
        uint8_t buf[512];
        rxChar.readValue(buf, len);

        // Collect Command:
        String Command = "";
        for (int i = 0; i < len; i++) Command += (char)buf[i];
        Command.trim();

        // Flash Onboard LED:
        for (int j = 0; j < 4; j = j + 1) {
          digitalWrite(LED_BUILTIN, LOW);
          delay(100);
          digitalWrite(LED_BUILTIN, HIGH);
          delay(100);
        }

        // Check Command Validity:
        bool Valid_Command = false;
        int numCommands = sizeof(Command_List) / sizeof(Command_List[0]);
        for (int i = 0; i < numCommands; i = i + 1) {
          if (Command == Command_List[i]) {
            Valid_Command = true;
            break;
          }
        }
        if (Valid_Command == false) {
          matrix.renderBitmap(Command_Unrecognised, 12, 8);
          delay(1000);
          return;
        }

        // TEST Command:
        if (Command == "TEST") {

          delay(10000);

          // Render Matrix:
          matrix.clear();
          delay(10);
          matrix.beginDraw();
          matrix.textFont(Font_4x6);
          matrix.beginText(2, 2, 1);  // (X, Y, State)
          matrix.println("T");
          matrix.endText();
          matrix.endDraw();

          // Send S_Code      Right Leg            Waist  Left Leg              Right Arm                 Neck     Left Arm
