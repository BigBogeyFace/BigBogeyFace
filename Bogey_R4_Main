// Setup:
void setup() {

  // Built in LED PinMode:
  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(LED_BUILTIN, HIGH);

  // Instantiate Matrix:
  matrix.begin();

  // Initialize hardware serial port 1 at 115200 baud:
  Serial1.begin(115200);

  // Instantiate Bluetooth:
  BLE.begin();
  BLE.setLocalName("UNO_R4_UART");
  BLE.setAdvertisedService(uartService);
  uartService.addCharacteristic(rxChar);
  uartService.addCharacteristic(txChar);
  BLE.addService(uartService);
  BLE.advertise();
}

// Program Loop:
void loop() {

  // Render Bitmap Image:
  for (int i = 0; i < 10; i = i + 1) {
    Check_BLE();
    matrix.renderBitmap(Small_Heart, 12, 8);
    delay(100);
  }

  for (int i = 0; i < 2; i = i + 1) {
    Check_BLE();
    matrix.renderBitmap(Large_Heart, 12, 8);
    delay(100);
    Check_BLE();
    matrix.renderBitmap(Small_Heart, 12, 8);
    delay(100);
  }
}
