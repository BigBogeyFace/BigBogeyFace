import time
from plasma import WS2812
from servo import servo2040

# Setup the LED bar
led_bar = WS2812(servo2040.NUM_LEDS, 1, 0, servo2040.LED_DATA)
led_bar.start()

def set_led(index, red, green, blue):
    """Sets a specific LED (0 to 5) to an RGB color (0 to 255)."""
    if 0 <= index < servo2040.NUM_LEDS:
        led_bar.set_rgb(index, red, green, blue)

# Set LEDs (LED, R, G, B):
set_led(5, 30, 0, 0) 
set_led(4, 30, 30, 0) 
set_led(3, 0, 30, 0) 
set_led(2, 0, 30, 30) 
set_led(1, 0, 0, 30) 
set_led(0, 30, 0, 30) 

# Keep program running to display colors
while True:
    time.sleep(1.0)
